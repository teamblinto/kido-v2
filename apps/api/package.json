{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API",
  "main": "dist/main.js",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "nest build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "nest start --watch",
    "lint": "eslint .",
    "byos:provider": "node dist/scripts/byos-provider.js",
    "sandbox:pool": "node dist/scripts/sandbox-pool.js",
    "sandbox:register": "node dist/scripts/register-sandbox.js",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "repo:verify": "node dist/scripts/repo-verify.js",
    "template:publish": "node dist/scripts/template-publish.js publish",
    "template:show": "node dist/scripts/template-publish.js show",
    "test": "vitest run --allowOnly=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "openai": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/types": "workspace:*",
    "@zxcvbn-ts/core": "catalog:",
    "@zxcvbn-ts/language-common": "catalog:",
    "@zxcvbn-ts/language-en": "catalog:",
    "bullmq": "catalog:",
    "compression": "catalog:",
    "cookie-parser": "catalog:",
    "drizzle-orm": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "jose": "catalog:",
    "nestjs-pino": "catalog:",
    "otpauth": "catalog:",
    "pg": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/compression": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
