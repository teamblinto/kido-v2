# Placeholders only. Never commit a real secret, key or credential.

NODE_ENV=development
# What this deployment IS, separate from which build is running. Anything that must be
# refused on a real deployment (the env KEK provider, weakened argon2 cost) keys on this.
DEPLOY_ENV=local
HOST=0.0.0.0
PORT=3000
API_PREFIX=api
API_VERSION=1
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Database -- three roles. forge_app is the request path and is subject to RLS;
# forge_bypass is for cross-tenant work; forge_migrator owns the schema.
DATABASE_URL=postgres://forge_app:forge_app@localhost:5432/forge
DATABASE_URL_BYPASS_RLS=postgres://forge_bypass:forge_bypass@localhost:5432/forge
DATABASE_MIGRATION_URL=postgres://forge_migrator:forge_migrator@localhost:5432/forge
DATABASE_POOL_MAX=10
DATABASE_BYPASS_POOL_MAX=2

# Redis -- three roles, three instances. Sessions must not share an instance with the cache,
# and the queue must not share one with either: an evicted job key is lost work.
REDIS_SESSION_URL=redis://localhost:6379
REDIS_CACHE_URL=redis://localhost:6380
REDIS_QUEUE_URL=redis://localhost:6381
REDIS_STREAM_URL=redis://localhost:6382

# Run profiles: which of api (HTTP), agent (agent.run worker), events (event workers), cron
# (relay/reaper) this process runs. The all-in-one set is local-only (DEPLOY_ENV=local).
RUN_PROFILES=api,agent,events,cron
# How often the outbox relay looks for unpublished rows. The test suites set 50.
OUTBOX_RELAY_TICK_MS=1000

# Agent runs (spec 008): the model id recorded on each run. Nothing calls it until 011.
AGENT_DEFAULT_MODEL=claude-sonnet-5

# Anthropic (spec 011)
# ANTHROPIC_API_KEY=
# A local Anthropic-compatible proxy for by-hand runs (local-only, like the key): its base URL, the
# prefix it puts on model ids and the suffix it appends to tool names, if any.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL_PREFIX=
# ANTHROPIC_TOOL_SUFFIX=

# Session cookie. The __Host- prefix is required: it is what makes the browser enforce
# "no Domain attribute" rather than trust us to omit it. There is no Secure switch.
SESSION_COOKIE_NAME=__Host-forge_session
SESSION_TTL_SECONDS=1209600
CSRF_COOKIE_NAME=forge_csrf

# Key encryption. The env provider holds the master key in plaintext and is refused
# whenever DEPLOY_ENV is not "local"; a real deployment uses openbao.
KEK_PROVIDER=env
# 32 zero bytes. Replace for anything that matters; generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
KEK_ENV_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# OPENBAO_ADDR=https://openbao.internal:8200
# OPENBAO_TOKEN=
OPENBAO_KEY_NAME=forge-kek

# Mail. The console mailer prints the link; resend requires RESEND_API_KEY.
MAIL_PROVIDER=console
MAIL_FROM=Forge <noreply@forge.dev>
# RESEND_API_KEY=

# Password policy. Argon2id at 64 MB / t=3 / p=1 is mandated; lower values are permitted
# only when DEPLOY_ENV=local, to keep the test suite fast.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
BREACH_CHECK_ENABLED=true

# OAuth. Both halves of a provider must be set, or neither -- neither means disabled.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub App connector (spec 018). All four GITHUB_APP_* or none -- none means install answers
# oauth-provider-not-configured. Register a throwaway App locally: Setup URL
# http://localhost:5173/connectors/github/callback, permissions Contents read & write,
# Metadata read, Administration read & write, no webhook (README "Services the API needs").
# The App's numeric id from its settings page; what the App JWT is issued as.
# GITHUB_APP_ID=1
# The App's client id; carried for the user-authorisation step that is not run today.
# GITHUB_APP_CLIENT_ID=Iv1.example
# The App's URL slug; the install URL is <GITHUB_INSTALL_URL>/apps/<slug>/installations/new.
# GITHUB_APP_SLUG=forge-local
# The PEM in double quotes with backslash-n newlines. LOCAL-ONLY EXAMPLE KEY, refused unless DEPLOY_ENV=local.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA4emgx1yE5A7nyR0WBnsl323JlKcvT4ZCbYuxxBGtdQ3tCz7n\nUjJ7lEVCWSc0Has4jkyK9Q1d/iwkJ0Zsj53BczcWwP2XDQk1ML28oRf7XxKLo2Up\naSbUqmROBiTousn/4laH34P8etpCUIqHW3aCGbEpkwNISCgcjC7PoQdORcYVPRMd\nCh/lbcZsaoGGCVXIAa2l2OfMwjqkm4A+HxU3idiLZ5532kIlPzgyF00ttDGrZo0D\nE1dbo5dbaLM92nnywxjklOLkHSVUskULhVtlM8HC82h1kJB9ToLKm+ZF3ryWCa8m\na0JQMApStRc/oWbmWpfSTKxK4MdcxfG9AwZOeQIDAQABAoIBAAI+MvwMGeI3aghb\njVgFZuVzf6TRmcFsPMhU1Zjch4ZOUFE7flVHi054JcAVIA/uEzihAmBdHZEED6Ix\n1E3UjBiPEVNbee0itSG3ErnHo6z1p37+w6FarpHyVl1AQKcZwA3dR8zj0KDfz5uP\nj3NMhfY/P9LrzAM973AUUrg7KWIx2kSp1qYXn24R7Qo0Q4We/dxrkk7CPqt3NUhN\nhTtc/u3dhmVT0cvPDDujyi/YO5MaG/XLRM0A+pCxIOHtz2WjAwPwpeQ2VwympawH\nHUGWlecDXR2FhTrMtbpZfaPUjMa0IacOyT4JbBkhwV4UTRjebDju3ILw3qYnFHl3\nOXCqsXMCgYEA/dYcCHYJu2pcF3EKuPq9isMvx9eEKbZE/o8V8bxJdVVHJhwU2DZr\n2a0KjhYwAjJHEEgP/idg/h//vrufeC/tBtljCWQ4dyo7eReU3nlS6eA0oD7BXi0Y\nLMAghc+0JxkkVVCqn2iDCCVSVyXzFgBbE9ybraB2uy82ztAJ32rqGKsCgYEA49aW\nNWvwXiy6mk+GQK6uVQu2Ln5a8BzV+BM3iCTmylxyrTntXTBM895sg95l832Iwnb5\nd8TCZ6iERMrrldA7FMcGIRju0NlH54j/CXyeCzZwmMx5OqLIa9KhSzLg9aE9DPu6\nkarW5+XLJ2J94qwyk0cRaRUtcVGjQ56THiRn/WsCgYEAx3X5rURjvVuEZf8z98tA\nKcvaveRCPCy35ng1PDFCX+rU78NdNdD9ypzJEIGq0+8CHG8j8girlMU8R3pTgzPV\nw24K/pQ8MpeDCFJZbsBTQOgnMkxd0k0JFBEc/UkLPTXqcQfkK0MKw9nf7A8sBvvc\nlaziv/q5kbk2Dik3uNHgheUCgYBqQx0PkWYsJiRp8AknhdEdLTcs/BWhw3EwIJZX\n0w4o93EsxcWlHu/lFan63vEh3Ty5pg+4AnbBLeFyzEmQN+w2RpTfPuezVIOqw0Rf\nwlVb2Woueb9Yz682SqibkAFHzonQ0l8zrUBKK+zSU6du3u0/r3e5UP0+ytqgoQbw\nmf4+PQKBgCzavOLUcRWFi8RMM2DyguReo4JawA/nMjliZgrJO5Hq0ApNrH9ao0ze\nM/CEoq5+xpqHKFbQqT5qoy2ALoXiryahGo6qVsgl76TZ40jbxCufCQh7EXw/52SN\nvE3y1kCuPoJcSBOmT46ZwGCSyRpf1bVO7rvsfXSMm/W5EOIut8ww\n-----END RSA PRIVATE KEY-----\n"
# Where the client talks (GHES: your host); tests point it at the fixture server.
# GITHUB_API_URL=https://api.github.com
# Where users install and git clones from; the git auth header is keyed on this origin.
# GITHUB_INSTALL_URL=https://github.com
# The App's webhook signing secret (spec 026 R10), required. Every inbound delivery is verified
# against it before it is parsed. LOCAL-ONLY EXAMPLE SECRET, refused unless DEPLOY_ENV=local:
# a deployment verifying with a published value accepts anyone's signature.
GITHUB_WEBHOOK_SECRET=local-example-webhook-secret

# Turnstile verification. Inert when unset; the challenge itself is issued at the edge.
# TURNSTILE_SECRET_KEY=

# Daytona (spec 010). The sandbox module's control plane: the self-hosted v0.190.0 stack in
# infra/daytona (API on :3100), the Nightona fork, or app.daytona.io. Both-or-neither, and both are
# local-only: a key in the environment is refused whenever DEPLOY_ENV is not "local" (ADR 027).
# Daytona is not part of compose.yaml; `docker compose -f infra/daytona/compose.yaml up -d` runs
# it and writes all three values to infra/daytona/.generated/daytona.env — append that file here.
# DAYTONA_TEST_SANDBOX_ID gates test/sandbox-real.e2e-spec.ts and nothing else.
# DAYTONA_API_URL=
# DAYTONA_API_KEY=
# Real-deployment form (ADR 027 refuses the env key outside local): path to a file holding the key,
# exclusive with DAYTONA_API_KEY. DAYTONA_API_URL then points at sandboxd (http://<host>:3986).
# DAYTONA_API_KEY_FILE=
# DAYTONA_TEST_SANDBOX_ID=
# The forge.owner label on sandboxes this deployment creates; defaults to forge-${DEPLOY_ENV}.
# SANDBOX_OWNER=
# Where a sandbox posts its callbacks (spec 017); the API as the sandbox network reaches it.
# On Docker Desktop, localhost is the sandbox itself: use host.docker.internal
# (docs/runbooks/local-dev.md).
# SANDBOX_CALLBACK_URL=http://host.docker.internal:3000/api/v1/internal/sandbox-callbacks

# Object-store mirror (spec 016 FR-024). All-or-none, like Daytona above — and unlike Daytona,
# required outside DEPLOY_ENV=local: an unconfigured mirror is refused at boot, not skipped.
# OBJECT_STORE_ENDPOINT=
# OBJECT_STORE_ACCESS_KEY_ID=
# OBJECT_STORE_SECRET_ACCESS_KEY=
# OBJECT_STORE_BUCKET_REPOS=
# The bucket deployed sites are uploaded to (spec 027 R7): same endpoint and write credentials, and
# part of the same all-or-none group, so it is required with the other four.
# OBJECT_STORE_BUCKET_ARTIFACTS=

# Deployed sites are served at <site_label>.<SITE_DOMAIN> (spec 027 R10). Defaults to
# forge-site.localhost under DEPLOY_ENV=local and is required elsewhere. Refused if it equals, sits
# under or sits above PREVIEW_DOMAIN or APP_URL's host: a site is untrusted code served to the
# public and must never share a cookie scope with the product or a preview.
SITE_DOMAIN=forge-site.localhost

# Inbound webhooks (spec 029 R2) arrive at their own host. Defaults to hooks.localhost under
# DEPLOY_ENV=local and is required elsewhere; refused if it equals APP_URL's host.
# WEBHOOK_LEGACY_ADDRESS=true keeps the inbound paths served on the API's own host too, until every
# sender has moved to HOOKS_HOST.
HOOKS_HOST=hooks.localhost
WEBHOOK_LEGACY_ADDRESS=true

# Custom domains (spec 028 R15). The platform's Cloudflare for SaaS zone: all three of
# CLOUDFLARE_API_TOKEN / CLOUDFLARE_ZONE_ID / CUSTOM_HOSTNAME_TARGET or none -- none means the API
# registers no custom hostname. The token needs only "SSL and Certificates: Edit" on that zone and
# is held by the API and worker profiles alone, never the gateway (FR-032). CUSTOM_HOSTNAME_TARGET
# is the name tenants' CNAMEs point at; it must not equal, sit under or sit above PREVIEW_DOMAIN,
# SITE_DOMAIN or APP_URL's host. CLOUDFLARE_API_URL must be https: outside DEPLOY_ENV=local.
# Placeholders only.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CUSTOM_HOSTNAME_TARGET=edge.forge-saas.example
# CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
# Which CA issues a custom hostname's certificate: lets_encrypt (default) or google.
# CUSTOM_HOSTNAME_CA=lets_encrypt
# The public resolvers a domain check queries, as ip[:port], comma-separated. Never a hostname.
DNS_RESOLVERS=1.1.1.1,8.8.8.8
# Domains no tenant may attach, nor any name under them; comma-separated, lower-cased on read.
RESERVED_DOMAINS=

# Preview gateway routing (spec 017). Previews are served at <label>-<port>.<PREVIEW_DOMAIN>;
# route records and grants are Ed25519 JWS minted with PREVIEW_SIGNING_KEY (base64 PKCS8, named
# by PREVIEW_SIGNING_KEY_ID) and verified by the gateway against the public-only
# PREVIEW_PUBLIC_JWKS. The key is required outside DEPLOY_ENV=local; unset locally, a fresh pair
# is generated per boot and the JWKS is derived from it. None of these may be a VITE_* var.
PREVIEW_DOMAIN=forge-preview.localhost
# Local only: the dev gateway's port. Set, preview urls are http://<host>:<port> (the gateway is
# plain HTTP); unset, they are https://<host>. Refused unless DEPLOY_ENV=local.
PREVIEW_GATEWAY_PORT=3200
# Local dev sets an explicit pair so the gateway (which needs PREVIEW_PUBLIC_JWKS and cannot derive
# it) verifies what this API mints without copying a per-boot value. Keep it: unset, the gateway
# refuses every route this API mints. LOCAL-ONLY EXAMPLE PAIR — a
# published private key; never use it outside DEPLOY_ENV=local. Generate your own with:
#   node -e "const c=require('node:crypto');const {privateKey,publicKey}=c.generateKeyPairSync('ed25519');console.log(privateKey.export({format:'der',type:'pkcs8'}).toString('base64'),JSON.stringify(publicKey.export({format:'jwk'})))"
PREVIEW_SIGNING_KEY=MC4CAQAwBQYDK2VwBCIEIClBlmbC0DjHM+hnQ1EjcnKAA6eCquoHgpEXktA+YQ9T
PREVIEW_SIGNING_KEY_ID=local-example
PREVIEW_PUBLIC_JWKS={"keys":[{"crv":"Ed25519","x":"INR__-7fntjUokw81gj8mEA7CQOoY628_ah8zSrWFd4","kty":"OKP","alg":"EdDSA","kid":"local-example","use":"sig"}]}
# The broker listener the gateway calls. "plain" (node:http behind a shared-secret header) is
# local-only, like KEK_PROVIDER=env; a real deployment sets "mtls" with all four of
# BROKER_TLS_CA / BROKER_TLS_CERT / BROKER_TLS_KEY (PEM) and BROKER_CLIENT_CNS (comma-separated).
BROKER_TRANSPORT=plain
BROKER_PORT=3001
# BROKER_SHARED_SECRET=local-broker-secret
# BROKER_TLS_CA=
# BROKER_TLS_CERT=
# BROKER_TLS_KEY=
# BROKER_CLIENT_CNS=forge-gateway
# The gateway's route cache (SC-006's five seconds) and its bounds on one proxied exchange.
ROUTE_CACHE_MAX=1000
ROUTE_CACHE_TTL_MS=5000
GATEWAY_UPSTREAM_TIMEOUT_MS=30000
GATEWAY_SOCKET_MAX_MS=3600000

# Remaining connectors (spec 030 R12). Provider API base URLs the connector adapters call with a
# tenant's own credential; each defaults to the provider and must be https: outside DEPLOY_ENV=local.
# NETLIFY_API_URL=https://api.netlify.com/api/v1
# NEON_API_URL=https://console.neon.tech/api/v2
# SUPABASE_API_URL=https://api.supabase.com
# The Resend API for tenants' own keys -- not the platform mail's RESEND_API_KEY.
# CONNECTOR_RESEND_API_URL=https://api.resend.com
# The Supabase OAuth app, both or neither; neither means Supabase connect answers
# oauth-provider-not-configured. LOCAL-ONLY EXAMPLE SECRET, refused unless DEPLOY_ENV=local.
# SUPABASE_OAUTH_CLIENT_ID=
# SUPABASE_OAUTH_CLIENT_SECRET=local-example-supabase-secret
# Spec 032: linking a person's own subscription, one OAuth client per provider. Values come from
# docs/byos/anthropic.md and docs/byos/openai.md; unset means the provider is not offered.
# CLIENT_ID, TOKEN_URL, API_BASE_URL and SCOPES (space-separated) go together, plus one of
# AUTHORIZE_URL or DEVICE_URL. URLs must be https unless DEPLOY_ENV=local.
# BYOS_ANTHROPIC_CLIENT_ID=
# BYOS_ANTHROPIC_CLIENT_SECRET=
# BYOS_ANTHROPIC_AUTHORIZE_URL=
# BYOS_ANTHROPIC_TOKEN_URL=
# BYOS_ANTHROPIC_REVOKE_URL=
# BYOS_ANTHROPIC_DEVICE_URL=
# BYOS_ANTHROPIC_API_BASE_URL=
# BYOS_ANTHROPIC_SCOPES=
# BYOS_OPENAI_CLIENT_ID=
# BYOS_OPENAI_CLIENT_SECRET=
# BYOS_OPENAI_AUTHORIZE_URL=
# BYOS_OPENAI_TOKEN_URL=
# BYOS_OPENAI_REVOKE_URL=
# BYOS_OPENAI_DEVICE_URL=
# BYOS_OPENAI_API_BASE_URL=
# BYOS_OPENAI_SCOPES=
# BYOS_REFRESH_TIMEOUT_MS=10000

# Runner bridge (spec 040's wire): the command stream, uplink and executor every agent home's runner
# uses. LOCAL_AGENT_ENABLED defaults to true under DEPLOY_ENV=local and false elsewhere.
# LOCAL_AGENT_ENABLED=true
# The longest one turn of a subscription run may take before it is failed (seconds; default 6 h).
# LOCAL_AGENT_MAX_RUN_SECONDS=21600

# Cloud subscription agent (spec 041): the person's own Claude Code in a private Daytona sandbox
# ("agent home"), signed in by them through Anthropic's flow. Needs LOCAL_AGENT_ENABLED and a
# published `agent-home` template (`pnpm --filter @repo/api template:publish -- agent-home`).
# AGENT_HOME_ENABLED defaults to true under DEPLOY_ENV=local and false elsewhere.
# AGENT_HOME_ENABLED=true
# Where the runner inside a home reaches this API (https outside local; local default below).
# AGENT_HOME_SERVER_URL=http://host.docker.internal:3000
# The companion bundle uploaded into each home on start; unset resolves apps/companion/dist/main.js.
# AGENT_HOME_RUNNER_BUNDLE=/app/companion/main.js
# Claude Code version the template installs: stable, latest or x.y.z (part of the digest);
# outside DEPLOY_ENV=local with homes on it must be an exact x.y.z.
# AGENT_HOME_CLAUDE_VERSION=stable
# Optional egress allowlist, comma-separated IPv4 CIDRs, at most 10 (unset: open egress).
# AGENT_HOME_EGRESS_ALLOW_CIDRS=
# A running home with no active run is stopped after this many minutes since its last use.
# AGENT_HOME_IDLE_MINUTES=30
# A home not signed in and unused this many days is deleted (device revoked, sandbox removed).
# AGENT_HOME_UNUSED_DAYS=14
