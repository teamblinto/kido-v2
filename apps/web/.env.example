VITE_APP_NAME=Production Monorepo
# Leave empty to use the same origin (recommended behind the included reverse proxy).
VITE_API_URL=
# Must match the API's CSRF_COOKIE_NAME. The client reads this cookie and echoes it in
# X-CSRF-Token on every unsafe request; both sides default to the same value.
VITE_CSRF_COOKIE_NAME=forge_csrf
# Leave unset for local development. The API's TurnstileGuard is inert without its own
# TURNSTILE_SECRET_KEY, so a widget here would be a control that can never pass.
# VITE_TURNSTILE_SITE_KEY=
