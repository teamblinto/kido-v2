{
  "name": "@repo/sandboxd",
  "version": "0.1.0",
  "private": true,
  "description": "Daytona-compatible sandbox control plane backed by Docker",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "lint": "eslint .",
    "start": "node src/main.ts",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dockerode": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/dockerode": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
