# Placeholders only. Never commit a real secret, key or credential.

# What this deployment IS, separate from which build is running. A real deployment (staging,
# production) requires the mtls broker transport; local is the only place "plain" is accepted.
DEPLOY_ENV=local
PORT=3200

# Preview gateway routing (spec 017). Previews are served at <label>-<port>.<PREVIEW_DOMAIN> and
# verified against PREVIEW_PUBLIC_JWKS, the public-only JWKS the API mints
# PREVIEW_SIGNING_KEY's routes and grants against. The gateway never holds the signing key and
# cannot derive this itself, so — unlike the API, where it is optional under DEPLOY_ENV=local and
# derived from an ephemeral pair — it is required here in every DEPLOY_ENV, including local: copy
# the API's derived PREVIEW_PUBLIC_JWKS value, or pin both processes to the same explicit
# PREVIEW_SIGNING_KEY / PREVIEW_SIGNING_KEY_ID pair.
PREVIEW_DOMAIN=forge-preview.localhost
# LOCAL-ONLY EXAMPLE: the public half of the pair apps/api/.env.example ships under
# PREVIEW_SIGNING_KEY / PREVIEW_SIGNING_KEY_ID=local-example. A real deployment sets its own.
PREVIEW_PUBLIC_JWKS={"keys":[{"crv":"Ed25519","x":"INR__-7fntjUokw81gj8mEA7CQOoY628_ah8zSrWFd4","kty":"OKP","alg":"EdDSA","kid":"local-example","use":"sig"}]}

# The API/web origin the gateway redirects a non-public preview to for the grant exchange
# (§4, T030): <PRODUCT_ORIGIN>/preview-authorize?label=...&return=...
PRODUCT_ORIGIN=http://localhost:5173

# Deployed sites (spec 027). Served at <site_label>.<SITE_DOMAIN> from the artifacts bucket, read
# with a READ-ONLY key scoped to that bucket alone — never the API's OBJECT_STORE_* write key.
# SITE_DOMAIN is optional, so a preview-only gateway boots without any of these; when it is set,
# all four ARTIFACT_STORE_* are required, and none is accepted without it. The endpoint must be
# https: outside DEPLOY_ENV=local. SITE_DOMAIN must not equal, sit under or sit above
# PREVIEW_DOMAIN or PRODUCT_ORIGIN's host. Placeholders only.
# SITE_DOMAIN=forge-site.localhost
# ARTIFACT_STORE_ENDPOINT=http://localhost:9000
# ARTIFACT_STORE_BUCKET=forge-artifacts
# ARTIFACT_STORE_ACCESS_KEY_ID=
# ARTIFACT_STORE_SECRET_ACCESS_KEY=

# Custom domains (spec 028 R15). The secret the edge adds to every request it forwards for a
# tenant's hostname; a request without it is refused, so nothing reaches a custom hostname around
# the edge. Optional: unset, the gateway serves no custom hostname and previews and sites are
# unchanged. At least 32 characters, and requires SITE_DOMAIN. The gateway never holds a Cloudflare
# token (FR-032). Placeholder only; generate a real one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# EDGE_ORIGIN_SECRET=

# The broker listener the gateway calls, in apps/api. "plain" (node:http behind a shared-secret
# header) is local-only, like KEK_PROVIDER=env; a real deployment sets "mtls" with all three of
# BROKER_TLS_CA / BROKER_TLS_CERT / BROKER_TLS_KEY (PEM) — the gateway's own client cert/key and
# the CA it trusts for the broker's server certificate.
# The broker origin is <scheme from BROKER_TRANSPORT>://<BROKER_HOST>:<BROKER_PORT>.
BROKER_TRANSPORT=plain
BROKER_HOST=localhost
BROKER_PORT=3001
# BROKER_SHARED_SECRET=local-broker-secret
# BROKER_TLS_CA=
# BROKER_TLS_CERT=
# BROKER_TLS_KEY=

# The gateway's route cache (SC-006's five seconds) and its bounds on one proxied exchange.
ROUTE_CACHE_MAX=1000
ROUTE_CACHE_TTL_MS=5000
GATEWAY_UPSTREAM_TIMEOUT_MS=30000
GATEWAY_SOCKET_MAX_MS=3600000
# How long a waking preview may keep answering 202 before the "could not be woken" page.
GATEWAY_WAKE_BUDGET_MS=90000

# Local-only (R19): dial this origin instead of a route's upstream host when that host does not
# resolve from the gateway (Docker's proxy.localhost on Windows). Host/SNI stay the upstream's.
# PREVIEW_UPSTREAM_DIAL=http://127.0.0.1:4000
