{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "VITE_API_URL",
        "VITE_APP_NAME",
        "VITE_CSRF_COOKIE_NAME",
        "VITE_TURNSTILE_SITE_KEY"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "!.vite/**"]
    },
    "@repo/api#build": {
      "dependsOn": ["^build", "@repo/companion#build"],
      "env": [
        "NODE_ENV",
        "VITE_API_URL",
        "VITE_APP_NAME",
        "VITE_CSRF_COOKIE_NAME",
        "VITE_TURNSTILE_SITE_KEY"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "!.vite/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "AGENT_HOME_CLAUDE_VERSION",
        "AGENT_HOME_EGRESS_ALLOW_CIDRS",
        "AGENT_HOME_ENABLED",
        "AGENT_HOME_IDLE_MINUTES",
        "AGENT_HOME_RUNNER_BUNDLE",
        "AGENT_HOME_SERVER_URL",
        "API_PREFIX",
        "API_VERSION",
        "APP_URL",
        "ARGON2_MEMORY_KIB",
        "ARGON2_PARALLELISM",
        "ARGON2_TIME_COST",
        "ARTIFACT_STORE_ACCESS_KEY_ID",
        "ARTIFACT_STORE_BUCKET",
        "ARTIFACT_STORE_ENDPOINT",
        "ARTIFACT_STORE_SECRET_ACCESS_KEY",
        "BREACH_CHECK_ENABLED",
        "BROKER_CLIENT_CNS",
        "BROKER_HOST",
        "BROKER_PORT",
        "BROKER_SHARED_SECRET",
        "BROKER_TLS_CA",
        "BROKER_TLS_CERT",
        "BROKER_TLS_KEY",
        "BROKER_TRANSPORT",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_API_URL",
        "CLOUDFLARE_ZONE_ID",
        "CORS_ORIGINS",
        "CSRF_COOKIE_NAME",
        "CUSTOM_HOSTNAME_CA",
        "CUSTOM_HOSTNAME_TARGET",
        "DATABASE_BYPASS_POOL_MAX",
        "DATABASE_MIGRATION_URL",
        "DATABASE_POOL_MAX",
        "DATABASE_URL",
        "DATABASE_URL_BYPASS_RLS",
        "DEPLOY_ENV",
        "DNS_RESOLVERS",
        "EDGE_ORIGIN_SECRET",
        "GATEWAY_SOCKET_MAX_MS",
        "GATEWAY_UPSTREAM_TIMEOUT_MS",
        "GATEWAY_WAKE_BUDGET_MS",
        "GITHUB_API_URL",
        "GITHUB_APP_CLIENT_ID",
        "GITHUB_APP_ID",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_APP_SLUG",
        "GITHUB_INSTALL_URL",
        "GITHUB_OAUTH_CLIENT_ID",
        "GITHUB_OAUTH_CLIENT_SECRET",
        "GITHUB_WEBHOOK_SECRET",
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "HOST",
        "KEK_ENV_MASTER_KEY",
        "KEK_PROVIDER",
        "LOCAL_AGENT_CODEX_CHATGPT_AUTH",
        "LOCAL_AGENT_ENABLED",
        "LOG_LEVEL",
        "MAIL_FROM",
        "MAIL_PROVIDER",
        "MFA_CHALLENGE_MAX_ATTEMPTS",
        "MFA_CHALLENGE_TTL_SECONDS",
        "MFA_ENROLMENT_TTL_SECONDS",
        "MFA_ISSUER",
        "MFA_STEP_UP_TTL_SECONDS",
        "MFA_TOTP_DIGITS",
        "MFA_TOTP_DRIFT_STEPS",
        "MFA_TOTP_PERIOD_SECONDS",
        "NODE_ENV",
        "OPENBAO_ADDR",
        "OPENBAO_KEY_NAME",
        "OPENBAO_TOKEN",
        "PORT",
        "PREVIEW_DOMAIN",
        "PREVIEW_PUBLIC_JWKS",
        "PREVIEW_SIGNING_KEY",
        "PREVIEW_SIGNING_KEY_ID",
        "PREVIEW_UPSTREAM_DIAL",
        "PRODUCT_ORIGIN",
        "REDIS_CACHE_URL",
        "REDIS_QUEUE_URL",
        "REDIS_SESSION_URL",
        "RESEND_API_KEY",
        "RESERVED_DOMAINS",
        "ROUTE_CACHE_MAX",
        "ROUTE_CACHE_TTL_MS",
        "RUN_PROFILES",
        "SANDBOX_CALLBACK_URL",
        "SANDBOX_OWNER",
        "SESSION_COOKIE_NAME",
        "SESSION_TTL_SECONDS",
        "SITE_DOMAIN",
        "SWAGGER_ENABLED",
        "THROTTLE_LIMIT",
        "THROTTLE_TTL_MS",
        "TURNSTILE_SECRET_KEY",
        "VITE_API_URL",
        "VITE_APP_NAME",
        "VITE_CSRF_COOKIE_NAME",
        "VITE_TURNSTILE_SITE_KEY"
      ],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "AGENT_HOME_CLAUDE_VERSION",
        "AGENT_HOME_EGRESS_ALLOW_CIDRS",
        "AGENT_HOME_ENABLED",
        "AGENT_HOME_IDLE_MINUTES",
        "AGENT_HOME_RUNNER_BUNDLE",
        "AGENT_HOME_SERVER_URL",
        "ARGON2_MEMORY_KIB",
        "ARGON2_PARALLELISM",
        "ARGON2_TIME_COST",
        "BROKER_CLIENT_CNS",
        "BROKER_HOST",
        "BROKER_PORT",
        "BROKER_SHARED_SECRET",
        "BROKER_TLS_CA",
        "BROKER_TLS_CERT",
        "BROKER_TLS_KEY",
        "BROKER_TRANSPORT",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_API_URL",
        "CLOUDFLARE_ZONE_ID",
        "CUSTOM_HOSTNAME_CA",
        "CUSTOM_HOSTNAME_TARGET",
        "DATABASE_MIGRATION_URL",
        "DATABASE_URL",
        "DATABASE_URL_BYPASS_RLS",
        "DEPLOY_ENV",
        "DNS_RESOLVERS",
        "EDGE_ORIGIN_SECRET",
        "EXPECT_INTEGRATION",
        "GATEWAY_SOCKET_MAX_MS",
        "GATEWAY_UPSTREAM_TIMEOUT_MS",
        "GATEWAY_WAKE_BUDGET_MS",
        "GITHUB_API_URL",
        "GITHUB_APP_CLIENT_ID",
        "GITHUB_APP_ID",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_APP_SLUG",
        "GITHUB_INSTALL_URL",
        "GITHUB_WEBHOOK_SECRET",
        "KEK_ENV_MASTER_KEY",
        "KEK_PROVIDER",
        "LOCAL_AGENT_CODEX_CHATGPT_AUTH",
        "LOCAL_AGENT_ENABLED",
        "MFA_CHALLENGE_MAX_ATTEMPTS",
        "MFA_CHALLENGE_TTL_SECONDS",
        "MFA_ENROLMENT_TTL_SECONDS",
        "MFA_ISSUER",
        "MFA_STEP_UP_TTL_SECONDS",
        "MFA_TOTP_DIGITS",
        "MFA_TOTP_DRIFT_STEPS",
        "MFA_TOTP_PERIOD_SECONDS",
        "NODE_ENV",
        "PREVIEW_DOMAIN",
        "PREVIEW_PUBLIC_JWKS",
        "PREVIEW_SIGNING_KEY",
        "PREVIEW_SIGNING_KEY_ID",
        "PREVIEW_UPSTREAM_DIAL",
        "PRODUCT_ORIGIN",
        "REDIS_CACHE_URL",
        "REDIS_QUEUE_URL",
        "REDIS_SESSION_URL",
        "RESERVED_DOMAINS",
        "ROUTE_CACHE_MAX",
        "ROUTE_CACHE_TTL_MS",
        "RUN_PROFILES",
        "SANDBOX_CALLBACK_URL",
        "SANDBOX_OWNER",
        "SITE_DOMAIN"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
