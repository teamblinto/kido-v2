# Overrides for infra/daytona/compose.yaml. Optional: every value has the default shown here, so
# `docker compose -f infra/daytona/compose.yaml up -d` works without this file. Copy to `.env`
# (git-ignored, read by Compose from this directory) only to change one.

# Docker Hub has no v0.190.0 image tags (see compose.yaml); this is the last published set.
# Apple Silicon: v0.189.0-arm64.
DAYTONA_IMAGE_TAG=v0.189.0-amd64

# Host port for the Daytona API and dashboard. 3000 belongs to Forge's own API.
DAYTONA_API_PORT=3100
