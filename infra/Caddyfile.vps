# The edge for the single-VPS overlay (compose.vps.yaml). The site body is infra/Caddyfile's
# `:8080` block verbatim in behaviour (stream flush, hooks origin, assets, SPA fallback); what
# differs is that this one terminates TLS and has a second site for the preview gateway. Keep the
# two in step when one changes.
{
	# Nothing administers this process over HTTP.
	admin off

	# Preview hostnames are <label>-<port>.<PREVIEW_DOMAIN>: unbounded, and a stock Caddy cannot
	# do the DNS challenge a wildcard certificate needs, so certificates are issued on demand
	# per hostname. Without a strict `ask`, anyone could send random SNI names and burn the
	# domain's Let's Encrypt quota, so Caddy asks the gateway (TLS_ASK_PORT, compose.vps.yaml),
	# which says yes only for a label the broker knows, on its live route's port (a cold one: at
	# most a few hostnames per label). See apps/gateway/src/tls-ask.ts.
	on_demand_tls {
		ask http://api:3201/allowed
	}
}

# Liveness for the compose healthcheck; loopback only.
http://127.0.0.1:9123 {
	bind 127.0.0.1
	respond /healthz 200
}

# The app, the API and the hooks origin. Caddy provisions certificates for both names.
{$APP_HOST}, {$HOOKS_HOST} {
	encode gzip

	@hooks host {$HOOKS_HOST}
	handle @hooks {
		handle /github {
			rewrite * /api/v1/webhooks/github
			reverse_proxy api:3000
		}
		respond 404
	}

	# Spec 046: the MCP endpoint answers a tool call over SSE when it streams progress, so it
	# is flushed like the run stream. OAuth discovery lives at the origin root because RFC 8414
	# and RFC 9728 put it there; only those two documents go to the API, the rest of
	# /.well-known stays the web app's.
	@stream path /api/v1/*/stream /api/v1/mcp
	handle @stream {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	@discovery path /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource*
	handle @discovery {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	root * /srv

	handle /assets/* {
		header {
			Cache-Control "public, max-age=31536000, immutable"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
		}
		file_server
	}

	handle {
		header {
			Cache-Control "no-cache"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
		}
		try_files {path} {path}/ /index.html
		file_server
	}
}

# Previews: the gateway verifies the route record and proxies to sandboxd's preview listener. It
# shares the api container's network namespace (see compose.vps.yaml), hence `api:3200`. Streaming
# and WebSockets (Vite HMR) pass straight through.
https://*.{$PREVIEW_DOMAIN} {
	tls {
		on_demand
	}
	# A Vite dev server sends its modules (~2.8 MB for a React app) uncompressed. The match is an
	# allow-list rather than the default (which includes text/*), so text/event-stream is never
	# encoded and an SSE preview keeps flushing event by event; a 101 upgrade carries no
	# Content-Type, so HMR WebSockets never match either.
	encode zstd gzip {
		match {
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type application/wasm*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
			header Content-Type text/css*
			header Content-Type text/html*
			header Content-Type text/javascript*
			header Content-Type text/plain*
			header Content-Type text/xml*
		}
	}
	reverse_proxy api:3200 {
		flush_interval -1
	}
}
